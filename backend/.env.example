# Copy to .env (gitignored) or set these in your host's env-var UI.
# Never commit real values.

# Required in production. Local dev: any string works; a missing/insecure
# value is only rejected when DEBUG=False (see backend/settings.py).
SECRET_KEY=

# False in production (default). Local dev: DEBUG=True
DEBUG=False

# Comma-separated. Local dev example: ALLOWED_HOSTS=*
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app

# Neon's non-pooling connection string (required for migrations - see
# docs/ARCHITECTURE.md). DATABASE_URL is used as a fallback; SQLite is used
# if none of these are set.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Comma-separated. Falls back to localhost:3000/8000 if unset.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Optional: S3-compatible media storage. Leave unset to use local disk.
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
MEDIA_URL=
